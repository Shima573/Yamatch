<% content_for(:title, "登山用品") %>

<div class="min-h-screen">
  <div class="max-w-5xl mx-auto pt-10 pb-10 px-7">

    <%# ページタイトル・説明 %>
    <div class="border-b-2 border-primary-1200 pb-6 mb-6">
      <p class="text-2xl font-bold">
        <span class="text-primary-1200">・</span>
        登山用品について
      </p>

      <p class="text-base p-2 text-primary-90">
        登山を安全に楽しむためには、目的や環境に合った道具選びが大切です。<br>
        ここでは、初心者が知っておきたい登山用品の特徴や選ぶポイントを紹介します。
      </p>
    </div>

    <%# 登山用品一覧 %>
    <div class="space-y-4">
      
          <%# ザック %>
          <%= render "shared/equipment",
            name: "ザック（リュックサック）",
            image: "items/rucksack",
            description: "登山に必要な荷物を安全かつ一括して背負い、肩や腰のベルトで重量を分散・固定して疲労を軽減します。",
            details: {
              types: ["小型（デイパック・20〜30L前後）", "中型（35〜50L）", "大型（50L以上）"],
              point: "無雪期の日帰り登山であれば、20〜30L（または25〜35L）を目安に選ぶのが基本です。自分の背面長にしっかりフィットするものを選びましょう。",
              links: [
                {
                  name: "ザック（リュックサック）の選び方",
                  url: "https://www.montbell.jp/generalpage/disp.php?id=829"
                }
              ]
            } %>

      <%# 登山靴 %>
      <%= render "shared/equipment",
        name: "登山靴 / トレッキングシューズ",
        image: "items/climbing_shoes",
        description: "未舗装の山道や岩場、ぬかるみなどで足を保護し、滑り止めや足の疲労軽減を図るための専用靴です。",
        details: {
          types: ["ローカット", "ミドルカット", "ハイカット"],
          point: "初心者は足首を適度に支えるミドルカットを目安に、登山用ソックスを履いて試着し、つま先やかかとに無理のない、自分の足に合ったものを選びましょう。防水透湿性も確認すると安心です。",
          links: [
            {
              name: "登山靴の選び方",
              url: "https://clublog.club-t.com/_ct/17341469"
            }
          ]
        } %>

      <%# 登山用ソックス %>
      <%= render "shared/equipment",
        name: "登山用ソックス",
        image: "items/hiking_socks",
        description: "足への衝撃を和らげ、登山靴との摩擦による靴擦れやマメなどのトラブルを軽減するための靴下です。",
        details: {
          types: ["薄手", "中厚手", "厚手・極厚手"],
          point: "足への負担や靴擦れを軽減できる適度な厚みがあり、汗を処理しやすい化繊やメリノウールなどの素材を選びましょう。登山靴との相性も大切なので、実際に使用するソックスを履いた状態で靴のフィット感を確認するのがおすすめです。",
          links: [
            {
              name: "登山用ソックス",
              url: "https://www.montbell.jp/generalpage/disp.php?id=727"
            }
          ]
        } %>

      <%# 速乾性インナー %>
      <%= render "shared/equipment",
        name: "速乾性インナー（ベースレイヤー）",
        image: "items/base_layer",
        description: "肌に直接着用し、汗を吸収・発散して身体をできるだけドライに保つためのウェアです。汗による身体の冷えを抑えるため、乾きやすい化繊やウールなどの素材が適しています。",
        details: {
          types: ["化繊", "ウール", "混紡素材"],
          point: "汗をかいた後の身体の冷えを抑えるため、汗を処理しやすく乾きやすい素材を選びましょう。季節や運動量に合わせて厚さも調整します。",
          links: [
            {
              name: "インナーの選び方",
              url: "https://www.yamakei-online.com/yama-ya/detail.php?id=1981"
            }
          ]
        } %>

      <%# 防寒着 %>
      <%= render "shared/equipment",
        name: "防寒着（ミドルレイヤー）",
        image: "items/middle_layer",
        description: "標高の上昇や休憩時などに身体が冷えるのを防ぎ、体温を保つために着用するウェアです。",
        details: {
          types: ["フリース", "化繊インサレーション", "ダウン"],
          point: "季節や気温、行動中・休憩中などの用途に合わせて、フリースやダウン、化繊中綿などから選びましょう。ベースレイヤーの上に着用し、さらにレインウェアを重ねられるサイズ感もポイントです。",
          links: [
            {
              name: "防寒着の選び方",
              url: "https://www.yamakei-online.com/yama-ya/detail.php?id=4795"
            }
          ]
        } %>

      <%# レインウェア %>
      <%= render "shared/equipment",
        name: "レインウェア（上下セパレート）",
        image: "items/rainwear",
        description: "雨や風から身体を守るアウターレイヤーです。登山では上下セパレート型が一般的で、防水性だけでなく蒸れを逃がす透湿性も選ぶポイントになります。",
        details: {
          types: ["上下セパレート", "ポンチョタイプ"],
          point: "防水性だけでなく、汗や蒸れを逃がす透湿性のあるものを選びましょう。防寒着の上から着ることも考えて、試着時に腕や脚を動かしやすいか確認し、携行しやすい軽量・コンパクトなものを選ぶと安心です。",
          links: [
            {
              name: "レインウェアの選び方",
              url: "https://www.yamakei-online.com/yama-ya/detail.php?id=4897"
            }
          ]
        } %>

      <%# トレッキングパンツ %>
      <%= render "shared/equipment",
        name: "トレッキングパンツ（登山用ボトムス）",
        image: "items/trekking_pants",
        description: "足の屈伸運動を妨げずに動きやすさを確保し、草木や岩場による擦り傷、日焼け、虫刺され、冷えなどから脚を保護するためのパンツです。",
        details: {
          types: ["ロングパンツ", "ショートパンツ", "コンバーチブル"],
          point: "足を動かしやすいストレッチ性や汗をかいたときの速乾性を確認し、季節や登る山の環境に合ったものを選びましょう。",
          links: [
            {
              name: "トレッキングパンツ（登山用ボトムス）の選び方",
              url: "https://www.montbell.jp/generalpage/disp.php?id=626"
            }
          ]
        } %>

      <%# 帽子 %>
      <%= render "shared/equipment",
        name: "帽子",
        image: "items/hiking_hat",
        description: "日差しや紫外線から頭部を守り、暑い時期には熱中症対策にも役立ちます。",
        details: {
          types: ["ハット", "キャップ", "ニット帽"],
          point: "季節や気温に合わせて、通気性や速乾性、保温性などを確認しましょう。風の強い場所では、あご紐などで飛ばされにくいものも便利です。",
          links: [
            {
              name: "帽子の選び方",
              url: "https://yamap.com/magazine/51382"
            }
          ]
        } %>

      <%# 手袋 %>
      <%= render "shared/equipment",
        name: "手袋",
        image: "items/hiking_gloves",
        description: "岩や木などに触れた際のケガから手を守るほか、雨風や寒さによる手の冷えを防ぐために使用します。",
        details: {
          types: ["トレッキンググローブ", "レイングローブ", "防寒グローブ"],
          point: "季節や気温に合わせて、速乾性・防風性・保温性など必要な性能を確認して選びましょう。濡れても乾きやすい化繊やウールなどの素材が適しており、手を動かしやすくフィットするものを選ぶのがポイントです。",
          links: [
            {
              name: "手袋の選び方",
              url: "https://yamap.com/magazine/53920"
            }
          ]
        } %>


      <%# 地図・コンパス %>
      <%= render "shared/equipment",
        name: "地図・コンパス",
        image: "items/map_compass",
        description: "現在地や登山ルート、目的地の方向を確認するために使用します。スマートフォンのGPSアプリを利用する場合でも、バッテリー切れや故障などに備えるための重要な装備です。" %>

      <%# ヘッドランプ %>
      <%= render "shared/equipment",
        name: "ヘッドランプ",
        image: "items/headlamp",
        description: "暗い場所で両手を自由にしたまま、足元や周囲を照らすための照明です。日帰り登山でも、予定より下山が遅れて日没を迎える場合などに備えて携行します。" %>

      <%# ファーストエイドキット %>
      <%= render "shared/equipment",
        name: "ファーストエイドキット",
        image: "items/first_aid_kit",
        description: "登山中のケガや体調不良に備えて、応急処置に必要なものをまとめたセットです。絆創膏やテーピング、普段使用している薬など、自分に必要なものを準備しておきます。" %>

      <%# トレッキングポール %>
      <%= render "shared/equipment",
        name: "トレッキングポール（登山ストック）",
        image: "items/trekking_poles",
        description: "歩行時に身体を支え、登りや下りで足への負担を軽減するために使用する杖です。特に長時間の歩行や下山時のサポートとして役立ちます。" %>

      <%# ザックカバー %>
      <%= render "shared/equipment",
        name: "ザックカバー",
        image: "items/cover",
        description: "雨が降った際にザックへ被せ、ザックや中の荷物が濡れるのを軽減するためのカバーです。使用しているザックの容量に合ったサイズを選びます。" %>

      <%# ツェルト %>
      <%= render "shared/equipment",
        name: "ツェルト（簡易テント）",
        image: "items/zelt",
        description: "悪天候やケガなどで行動できなくなった場合に、雨風をしのいだり体温の低下を防いだりするために使用する簡易的なテントです。軽量でコンパクトに収納でき、緊急時の装備として利用されます。" %>

      <%# サコッシュ %>
      <%= render "shared/equipment",
        name: "サコッシュ / フロントバッグ",
        image: "items/sacoche",
        description: "スマートフォンや地図、行動食など、登山中によく使う小物をすぐ取り出せるように持ち歩くための小型バッグです。" %>

      <%# インナーシーツ・寝袋 %>
      <%= render "shared/equipment",
        name: "インナーシーツ / 寝袋",
        image: "items/sleeping",
        description: "山小屋泊やテント泊などで、就寝時の保温や衛生のために使用します。宿泊する場所や季節によって必要な装備が異なるため、事前に宿泊先の設備や条件を確認して準備します。" %>

    </div>
  </div>
</div>
