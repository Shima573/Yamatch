<div class="min-h-screen">
    <%# ページタイトル %>
    <h1 class="">登山プラン</h1>
    <%# エラーメッセージ %>
    <% if @plan.errors.any?%>
    <ul>
      <% @plan.errors.each do |error| %>
      <li><%= error.full_message %></li>
      <% end %>
    </ul>
    <% end %>
    <%# 入力フォーム %>
    <div class="">
        <%= form_with model: [@mountain, @plan] do |f| %>
        <%# 山の名前 %>
        <div class="">
            <p class="">登山予定の山名</p>
            <%= @mountain.name %>
        </div>
        <%# プランタイトル %>
        <div class="">
            <p class="">プランタイトル</p>
            <%= f.text_field :title %>
        </div>
        <%# 登山日 %>
        <div class="">
            <p class="">登山日</p>
            <%= f.date_field :climbing_date, class: "w-full cursor-pointer", min: Date.current %>
        </div>
        <%# 同行人数 %>
        <div class="">
            <p class="">同行人数</p>
            <div class="" data-controller="companion-count">
                <button type="button" data-action="click->companion-count#increment">+</button>
                <%= f.number_field :companion_count, value: 1 , min: 1, data: {"companion-count-target": "input"} %>
                <button type="button" data-action="click->companion-count#decrement">-</button>
            </div>
        </div>
        <%# ルート %>
        <div class="">
            <p class="">ルート</p>
            <%= f.text_area :route %>
        </div>
        <%# 持ち物 %>
        <div class="">
            <p class="">持ち物リスト</p>
            <div class="">
              <div class="">
                <p class="">基本の持ち物</p>
                <% basic_items.each do |item|%>
                  <%= f.check_box :equipment, { multiple: true }, item, nil %>
                  <%= f.label :equipment, item %>
                <% end %>
              </div>
              <div class="">
                <p class="">服装・レイヤリング（着替え含む）</p>
                <% clothing_items.each do |item|%>
                  <%= f.check_box :equipment, { multiple: true }, item, nil %>
                  <%= f.label :equipment, item %>
                <% end %>
              </div>
              <div class="">
                <p class="">快適・衛生用品</p>
                <% hygiene_items.each do |item|%>
                  <%= f.check_box :equipment, { multiple: true }, item, nil %>
                  <%= f.label :equipment, item %>
                <% end %>
              </div>
              <div class="">
                <p class="">あると安心・便利な道具</p>
                <% convenient_items.each do |item|%>
                  <%= f.check_box :equipment, { multiple: true }, item, nil %>
                  <%= f.label :equipment, item %>
                <% end %>
              </div>
              <div class="">
                <p class="">宿泊・山小屋（必要な場合）</p>
                <% lodging_items.each do |item|%>
                  <%= f.check_box :equipment, { multiple: true }, item, nil %>
                  <%= f.label :equipment, item %>
                <% end %>
              </div>
            </div>
        </div>
        <%# メモ %>
        <div class="">
          <p class="">メモ</p>
          <%= f.text_area :note %>
        </div>

        <%= f.submit "登山プランを作成" %>
        <% end %>
    </div>
</div>
